{
  "expo": {
    "name": "JP Vocab",
    "slug": "va-practice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "io.github.brad0924.vapractice",
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141821",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
