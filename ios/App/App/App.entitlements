<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.brad0924.vapractice</string>
	</array>
	<!-- App Attest 走哪一組 Apple 伺服器。TestFlight 與 App Store 的 build 都是 production；
	     development 是 Xcode 直接裝到手機上那種 build 才用的，本專案沒有那條路。
	     省略這個鍵的預設值也是 production，寫出來是為了讓 provisioning profile 少了
	     App Attest capability 時，簽章當場就倒——那比等一輪 TestFlight 才發現拿不到權杖便宜。 -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
